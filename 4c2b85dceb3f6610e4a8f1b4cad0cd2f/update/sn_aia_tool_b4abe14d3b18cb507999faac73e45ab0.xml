        <description>this tools fetches assets from inventory to be assigned to user</description>
        <input_schema>[]</input_schema>
        <name>Guardian Fetch Asset from Inventory</name>
        <record_type>custom</record_type>
        <script><![CDATA[(function(inputs) {
    var assetGr = new GlideRecordSecure('x_aleen_snguardian_asset');
    assetGr.addQuery('status.code',"UNASSIGNED");
    assetGr.query();
    if(assetGr.next()){
        return assetGr.getValue('sys_id');
    }else{
        return null;
    }
})(inputs);]]></script>
